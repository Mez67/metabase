# Test directory that stands in for Active Directory.
# departmentNumber holds the branch a user may see; "*" means every branch.
# Every password is: Passw0rd!

dn: ou=users,dc=corp,dc=local
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=corp,dc=local
objectClass: organizationalUnit
ou: groups

dn: uid=ali,ou=users,dc=corp,dc=local
objectClass: inetOrgPerson
uid: ali
givenName: Ali
cn: Ali Ahmadi
sn: Ahmadi
mail: ali@corp.local
departmentNumber: tehran
userPassword: Passw0rd!

