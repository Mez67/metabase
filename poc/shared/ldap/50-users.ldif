# Service account the portal uses to talk to Superset when Superset itself
# signs users in with LDAP. It has no branch, so it cannot use the portal.
dn: uid=svc-portal,ou=users,dc=corp,dc=local
objectClass: inetOrgPerson
uid: svc-portal
givenName: Portal
cn: Portal Service
sn: Service
mail: svc-portal@corp.local
userPassword: Passw0rd!

# Analysts: may sign in to Metabase / Superset directly and build dashboards.
dn: cn=bi-analysts,ou=groups,dc=corp,dc=local
objectClass: groupOfNames
cn: bi-analysts
member: uid=mina,ou=users,dc=corp,dc=local
member: uid=svc-portal,ou=users,dc=corp,dc=local
